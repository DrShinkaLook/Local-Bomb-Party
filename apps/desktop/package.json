{
  "name": "@bombparty/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "Kobi Dao",
  "description": "Electron desktop shell and React render view for Bomb Party.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k --success first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && npm run build:preload",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@bombparty/engine": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "dev.bombparty.desktop",
    "electronVersion": "32.3.3",
    "productName": "Bomb Party",
    "copyright": "Copyright (c) 2026 Kobi Dao",
    "files": ["dist/**", "dist-electron/**"],
    "extraResources": [
      { "from": "../../data", "to": "data" },
      { "from": "../../LICENSE.txt", "to": "LICENSE.txt" },
      { "from": "../../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "directories": { "output": "release" }
  }
}
